<?xml version="1.0" encoding="utf-8"?>
<!--
  折叠态（customContentView）：**必须**把 3 个按钮放在这里。
  Android 12+ 折叠高度上限约 64dp，所以这里只放一行文字 + 一行按钮：
      padding 4 + 文字约 18 + 间隔 4 + 按钮 34 + padding 4 ≈ 64dp
  HyperOS 会把常驻通知折叠到不可展开，如果按钮只放在 big view 里就永远看不到。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/notification_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_notification_root"
    android:orientation="vertical"
    android:paddingStart="10dp"
    android:paddingTop="3dp"
    android:paddingEnd="10dp"
    android:paddingBottom="3dp">

    <TextView
        android:id="@+id/notification_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#FFFFFFFF"
        android:textSize="13sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:layout_marginTop="3dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/action_add_rep"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_notification_action"
            android:gravity="center"
            android:text="@string/workout_action_add_rep"
            android:textColor="#FF4CAF50"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/action_complete_set"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_notification_action"
            android:gravity="center"
            android:text="@string/workout_action_complete"
            android:textColor="#FF4CAF50"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/action_finish"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_notification_action"
            android:gravity="center"
            android:text="@string/workout_notification_stop"
            android:textColor="#FFFF6B6B"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
